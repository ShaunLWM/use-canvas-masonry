{
  "name": "use-canvas-masonry",
  "version": "0.0.2",
  "description": "60fps infinite canvas with masonry layout and viewport virtualization",
  "keywords": [
    "react",
    "canvas",
    "masonry",
    "infinite",
    "pan",
    "zoom",
    "virtualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaunLWM/use-canvas-masonry"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "cp ../../README.md ./README.md"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.0"
  }
}
